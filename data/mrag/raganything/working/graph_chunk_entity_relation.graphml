<node id="Arms">
  <data key="d0">Arms</data>
  <data key="d1">anatomical_feature</data>
  <data key="d2">Long, flexible, flattened, tapering, strap-like appendages of Luidia sarsii africana, usually five in number and capable of breaking off easily from the central disc.</data>
  <data key="d3">chunk-e079ae16950de487467ccdcc018dc76d</data>
  <data key="d4">Field-Guide-to-SA-Offshore-Marine-Invertebrates_web-full-version_compressed.pdf</data>
