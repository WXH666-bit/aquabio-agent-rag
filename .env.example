# ===== LLM Providers (fill in your own keys) =====
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2-pro:free
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=AquaBio-AgentRAG

AQUABIO_LLM_PROVIDER=qwen
AQUABIO_VISION_PROVIDER=qwen
AQUABIO_LLM_CONNECT_TIMEOUT=10
AQUABIO_LLM_READ_TIMEOUT=90

QWEN_API_KEY=replace_with_your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

RAGANYTHING_TEXT_LLM_PROVIDER=qwen

DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-2.5-flash-lite

# ===== Cache & Offline =====
PIP_CACHE_DIR=.cache/pip
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_ENDPOINT=https://hf-mirror.com
MODELSCOPE_CACHE=.cache/modelscope

# ===== RAG-Anything =====
RAGANYTHING_PARSER=mineru
RAGANYTHING_PARSE_METHOD=auto
RAGANYTHING_PARSER_BACKEND=pipeline
RAGANYTHING_EMBEDDING_DIM=384
RAGANYTHING_MAX_SEGMENT_PAGES=40
RAGANYTHING_SEGMENT_OVERLAP=1
RAGANYTHING_MIN_IMAGE_SIZE=256

# ===== MRAG =====
MRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
MRAG_MODEL_CACHE=
MRAG_LOCAL_FILES_ONLY=false
MRAG_COLLECTION_NAME=aquabio_mrag
MRAG_TOP_K=12
MRAG_RERANK_TOP_K=6
MRAG_USE_GRAPH_MCP=false
MRAG_REACT_NATIVE=true

# ===== MCP =====
RAGANYTHING_MCP_URL=http://127.0.0.1:8765/mcp
RAGANYTHING_MCP_TIMEOUT=35
RAGANYTHING_QUERY_TIMEOUT=25
AQUABIO_CHAT_UI_TIMEOUT=360
MRAG_MAX_RETRY=1
AQUABIO_API_URL=http://127.0.0.1:8000
